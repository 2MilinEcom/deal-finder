<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Deal Finder uses your location to find nearby stores and show relevant saved deals.</string>

    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Deal Finder can monitor selected store locations so it can notify you when you arrive.</string>

    <key>NSCameraUsageDescription</key>
    <string>Deal Finder uses the camera to scan shopping receipts.</string>
</dict>
</plist>
